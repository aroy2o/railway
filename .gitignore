# --- Secrets / local config -------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# --- Node -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Build output -----------------------------------------------------------
backend/dist/
frontend/dist/
frontend/.vite/

# --- Data -------------------------------------------------------------------
# Downloaded source datasets (~98 MB) and generated output are reproducible
# from the scripts in /data, so they are not committed. Keep the folders.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ...but DO commit the provenance records. They are small, and they are the
# evidence of which bytes produced which output - which is exactly what should
# survive in version control.
!data/raw/MANIFEST.json
!data/processed/INGESTION_REPORT.json
!data/processed/TIMETABLE_REPORT.json
!data/processed/SYNTHETIC_REPORT.json
!data/processed/SEASONAL_RISK_REPORT.json

# --- Editors / OS -----------------------------------------------------------
.DS_Store
.idea/
*.swp
