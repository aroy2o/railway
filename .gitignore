# --- Data -------------------------------------------------------------------
# Downloaded source datasets and generated synthetic output are reproducible
# from the scripts in /data, so they are not committed. Keep the folders.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

