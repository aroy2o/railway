# Environment for `npm test`, loaded via node --env-file.
#
# Committed on purpose: it makes the suite self-contained, so a fresh clone can
# run `npm test` without first copying .env.example. Node applies this before
# any module loads, and dotenv does not overwrite variables that are already
# set, so these values win over the repo-root .env.
#
# Nothing here is a real secret.

NODE_ENV=test
LOG_LEVEL=silent

# Never actually connected to during tests - app.js does not open a connection,
# which is exactly what lets /health/ready be asserted as "not ready".
MONGODB_URI=mongodb://127.0.0.1:27017/railway_block_planning_test

JWT_SECRET=test-only-secret-not-used-for-anything-real

# The real optimizer. T10's orchestration tests need to reach it, and they skip
# cleanly when it is not running.
#
# The "optimizer unreachable" cases are simulated by stubbing fetch rather than
# by pointing at a dead port. That is deterministic whether or not the service
# happens to be up, and it is closer to the real failure - a dead port and a
# crashed service look the same to the caller. Pinning a dead port here made the
# two requirements mutually exclusive in one process.
OPTIMIZER_URL=http://localhost:8000
OPTIMIZER_TIMEOUT_MS=2000
