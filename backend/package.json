{
  "name": "railway-block-planning-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the AI-assisted railway maintenance block planning system (SIH 26027). Handles auth, CRUD and orchestration of the Python optimizer service.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "seed": "tsx src/scripts/seed.ts",
    "demo:reset": "tsx src/scripts/demoReset.ts",
    "test": "node --env-file=tests/.env.test --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
