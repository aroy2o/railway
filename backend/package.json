{
  "name": "railway-block-planning-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the AI-assisted railway maintenance block planning system (SIH 26027). Handles auth, CRUD and orchestration of the Python optimizer service.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --env-file=tests/.env.test --test tests/",
    "seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^8.20.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
