# ---------------------------------------------------------------------------
# Single source of configuration for all three services.
#
# Copy to `.env` at the REPO ROOT (not per-service) and edit:
#     cp .env.example .env
#
# All three services resolve this one file:
#   - backend   -> dotenv, repo-root .env then backend/.env override
#   - optimizer -> pydantic-settings, repo-root .env then optimizer/.env override
#   - frontend  -> Vite `envDir` points at the repo root (VITE_* vars only)
#
# See docs/DECISIONS.md (D-002) for why config is centralised rather than
# duplicated per service.
# ---------------------------------------------------------------------------

# --- Shared -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Backend: Node/Express API ---------------------------------------------
BACKEND_PORT=5000
# Mongo connection string. Local dev assumes a mongod on the default port;
# under docker-compose the host becomes the `mongo` service name.
MONGODB_URI=mongodb://localhost:27017/railway_block_planning
# CORS allow-list for the browser app. Comma-separated, no trailing slash.
CORS_ORIGIN=http://localhost:5173

# JWT auth (FR10.2). MUST be overridden with a long random value outside dev:
#     openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=12h

# Where the Node API reaches the Python optimizer service. Node never calls
# OR-Tools directly (CLAUDE.md tech-stack rule) - it always goes over this URL.
OPTIMIZER_URL=http://localhost:8000
# Ceiling on a single optimizer HTTP call. Must exceed SOLVER_MAX_SECONDS so a
# solve that legitimately runs to its own time limit is not cut off in transit.
OPTIMIZER_TIMEOUT_MS=30000

# --- Optimizer: Python/FastAPI service --------------------------------------
OPTIMIZER_HOST=0.0.0.0
OPTIMIZER_PORT=8000
# Wall-clock ceiling handed to CP-SAT per solve. PRD Section 7 requires a
# weekly-horizon solve to return in <10s for ~50-100 tasks; this is the hard
# stop that guarantees the API answers even if the model has not proved
# optimality.
SOLVER_MAX_SECONDS=10
# CP-SAT worker threads. 0 = let OR-Tools pick based on available cores.
SOLVER_NUM_WORKERS=0

# Where `npm run seed` reads the data pipeline's output from. Relative paths
# resolve against the repo root. Regenerate the files with the commands in
# data/README.md before seeding.
DATA_PROCESSED_DIR=data/processed

# Claude API key - not used yet. Consumed by the /explain endpoint (T18, PRD
# 9.2). Leave blank until then; the service must start fine without it.
# Ask the Planner (T18). `anthropic` or `groq`.
# Neither the grounding contract nor the output verification depends on this
# choice - see docs/DECISIONS.md D-052.
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
# gpt-oss-120b is a plain LLM. Do NOT default to a groq/compound model: they can
# reach the internet, and they bill against gpt-oss-120b's rate limit anyway.
GROQ_MODEL=openai/gpt-oss-120b
EXPLAIN_MAX_TOKENS=700

# --- Frontend: React/Vite ---------------------------------------------------
# Only VITE_-prefixed vars are exposed to browser code. Never put a secret here.
VITE_API_BASE_URL=http://localhost:5000/api
# PRD Section 5 requires this disclaimer to be visible in the running app.
# Kept in config so the wording is reviewable in one place and cannot be
# silently dropped from the UI.
VITE_PROTOTYPE_BANNER=Prototype uses synthetic maintenance data anchored to real railway infrastructure and timetable data.
